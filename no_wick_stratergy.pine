//@version=6
// ============================================================================
//  NO Candle Strategy (15-minute chart)
// ============================================================================
//  Rules
//  • Trend (input "Trend mode"):
//    – Internal trend = direction of the most recent break of structure (BOS). Swings are
//      body pivots (max/min of open, close) with N bars each side; a BOS is a candle CLOSE
//      beyond the last unbroken swing high/low. Pivots confirm N bars late (no repaint).
//    – EMA trend: close vs EMA(200). close == EMA = no bias.
//    – "Internal + EMA" (default): internal trend decides; 1 BOS is enough when it agrees
//      with the EMA side, 2 BOS in a row are needed when it is against it.
//      "Internal only", "EMA only" and "Either" are also available.
//  • Bullish NO candle: close > open and open == low. Bearish: close < open and
//    open == high. Wick tolerance > 0 lets the open sit up to N ticks from the
//    low/high. Dojis and zero-range candles never qualify (close must differ from open).
//  • Only trend-aligned NO candles create a setup. Level = the NO candle's open.
//  • When the NO candle (candle #0) closes, a resting limit order is placed at the
//    level. With process_orders_on_close = false it can fill on candles #1–#9
//    (a wick touch is enough). It is cancelled when candle #9 closes.
//  • If, after a confirmed candle closes, the trend mode no longer allows the setup's
//    direction, the setup is cancelled at that close.
//  • Up to N pending setups. When full, the oldest is evicted. The first fill
//    cancels all others: pending entries share an OCA-cancel group, so the broker
//    emulator cancels them the instant one fills (before any later touch can fill).
//  • Commission defaults to 0 (edit in Settings → Properties). Slippage: 2 ticks.
//  • One position at a time. NO candles are ignored while a trade is open.
//  • Stop loss (input "Stop loss"):
//    – "Last swing" (default): below the most recent confirmed swing low (longs) or above
//      the most recent confirmed swing high (shorts) at the NO candle's close — the HL/LL
//      or HH/LH marker level (or its wick), minus/plus a tick buffer. No valid swing
//      beyond the level → no setup.
//    – "NO range × multiplier": risk = NO range × SL multiplier from the fill.
//    TP = fill ± (distance from fill to SL) × RR, measured from the ACTUAL fill price.
//
//  Execution notes
//  • Setup creation, expiry and trend invalidation run only on barstate.isconfirmed,
//    so calc_on_order_fills cannot leak a bar's final close into mid-bar executions.
//  • Fill handling is NOT gated by isconfirmed. It is idempotent (keyed on the
//    entry id), so repeated executions on the same bar (after fills or realtime
//    ticks) cannot duplicate SL/TP, cancellations or drawings. Alerts use varip
//    guards so each fires once.
//
//  Known limitations (by design; no lookahead is used to "fix" these)
//  • If one bar crosses several pending levels, TradingView's broker emulator picks
//    the fill. The script still guarantees only one trade.
//  • If the trend flips and the level is touched in the same bar, OHLC cannot tell
//    which came first. The fill stands; that bar's close is not used to unwind it.
//  • If one bar crosses both SL and TP, the broker emulator decides which fills.
//  • Drawing limits: only the most recent ~250 trades keep their TP/SL zones/tags.
// ============================================================================
strategy("NO Candle Strategy", shorttitle = "NO Candle", overlay = true,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 10,
     commission_type         = strategy.commission.percent,
     commission_value        = 0,
     slippage                = 2,
     pyramiding              = 0,
     process_orders_on_close = false,
     calc_on_every_tick      = true,
     calc_on_order_fills     = true,
     use_bar_magnifier       = true,
     max_lines_count         = 500,
     max_labels_count        = 500,
     max_boxes_count         = 500,
     behind_chart            = false)   // draw markers, zones and text in front of the candles

// ─── Constants ───────────────────────────────────────────────────────────────
// One palette, matching TradingView's Long/Short Position tool.
const color TP_COLOR         = #089981   // green: longs, TP zone
const color SL_COLOR         = #F23645   // red: shorts, SL zone
const color ENTRY_LINE_COLOR = #B2B5BE   // light grey entry line between the zones
const color EMA_COLOR        = #FF9800
const color STRUCT_COLOR     = #90A4AE   // muted: swing markers and levels

const int ZONE_OPEN_TRANSP = 80   // zones while the trade is open
const int ZONE_HIT_TRANSP  = 72   // closed trade: the side that was hit
const int ZONE_MISS_TRANSP = 88   // closed trade: the other side

const string GRP_TREND = "Trend"
const string GRP_NO    = "NO Candle"
const string GRP_RISK  = "Risk"
const string GRP_DIR   = "Directional"
const string GRP_VIS   = "Visualization"

// ─── Inputs ──────────────────────────────────────────────────────────────────
string trendModeInput         = input.string("Internal + EMA", "Trend mode", options = ["Internal + EMA", "Internal only", "EMA only", "Either"], group = GRP_TREND,
     tooltip = "Internal + EMA: last BOS decides; 1 BOS if it agrees with the EMA side, 2 BOS in a row if against. Either: internal OR EMA agrees.")
int   pivotLengthInput        = input.int(2, "Swing pivot length (bars)", minval = 1, group = GRP_TREND,
     tooltip = "Bars on each side of a body swing. A swing is confirmed this many bars after it forms.")
int   emaLengthInput          = input.int(200, "EMA length", minval = 1, group = GRP_TREND)

int   setupValidityBarsInput  = input.int(9, "Setup validity (candles)", minval = 1, maxval = 100, group = GRP_NO,
     tooltip = "The NO candle is candle #0. Its level may be touched on candles #1 to #N. The setup expires when candle #N closes.")
int   maxActiveSetupsInput    = input.int(3, "Max pending setups", minval = 1, group = GRP_NO,
     tooltip = "When full, the oldest pending setup is removed to make room for the newest.")
int   wickToleranceTicksInput = input.int(0, "Wick tolerance (ticks)", minval = 0, group = GRP_NO,
     tooltip = "0 = exact: open must equal the low (bullish) or the high (bearish).")

string slModeInput            = input.string("Last swing", "Stop loss", options = ["Last swing", "NO range × multiplier"], group = GRP_RISK)
int   slBufferTicksInput      = input.int(0, "Swing SL buffer (ticks)", minval = 0, group = GRP_RISK,
     tooltip = "Breathing room beyond the swing. On 5-digit forex, 10 ticks = 1 pip.")
bool  slUseWickInput          = input.bool(false, "Swing SL beyond the swing candle's wick", group = GRP_RISK,
     tooltip = "Off: SL at the marked body swing (HL/LL, HH/LH). On: SL beyond that candle's wick.")
float riskMultiplierInput     = input.float(2.0, "SL multiplier (× NO candle range)", minval = 0.01, step = 0.1, group = GRP_RISK,
     tooltip = "Used only when Stop loss = NO range × multiplier.")
float rrRatioInput            = input.float(1.0, "Reward:risk ratio", minval = 0.01, step = 0.1, group = GRP_RISK)

bool  enableLongsInput        = input.bool(true, "Enable longs", group = GRP_DIR)
bool  enableShortsInput       = input.bool(true, "Enable shorts", group = GRP_DIR)

bool  showEmaInput            = input.bool(true,  "Show EMA", group = GRP_VIS)
bool  showStructureInput      = input.bool(true,  "Show swings (HH/LH/HL/LL)", group = GRP_VIS)
bool  showNoCandlesInput      = input.bool(true,  "Show NO candle markers", group = GRP_VIS)
bool  showPendingLevelsInput  = input.bool(false, "Show pending levels", group = GRP_VIS)
bool  showActiveSlTpInput     = input.bool(true,  "Show TP/SL zones while trade is open", group = GRP_VIS)
bool  showTradeCirclesInput   = input.bool(true,  "Show entry circles", group = GRP_VIS)
bool  showTradeLinesInput     = input.bool(true,  "Show TP/SL zones on closed trades", group = GRP_VIS)
bool  showTradeLabelsInput    = input.bool(true,  "Show TP/SL tags", group = GRP_VIS)

// ─── Types ───────────────────────────────────────────────────────────────────
// A pending NO candle setup. noHigh/noLow/noRange are frozen at creation and never recalculated.
type NoSetup
    int    direction    // 1 = long, -1 = short
    float  level        // NO candle open = resting limit price
    float  noHigh
    float  noLow
    float  noRange      // noHigh - noLow
    int    creationBar  // candle #0
    int    expiryBar    // last candle allowed to touch; the order is cancelled when it closes
    float  stopPrice    // swing SL frozen at creation; na in "NO range × multiplier" mode
    string orderId
    int    seq
    line   levelLine

// The open trade's frozen bracket. Replaced with a fresh object when the trade closes.
type ActiveTrade
    string entryId = ""
    float  level
    float  slPrice
    float  tpPrice
    box    tpBox
    box    slBox
    line   entryLine

// Entry circle position. Survives the flat reset, so a trade that opens and closes on the same bar still gets its circle.
type EntryMark
    int   barIndex  = -1
    float price
    int   direction = 0

// ─── Functions ───────────────────────────────────────────────────────────────
symbolText() =>
    syminfo.prefix + ":" + syminfo.ticker

directionText(int dir) =>
    dir == 1 ? "LONG" : "SHORT"

// True if the selected trend mode allows trading in direction d.
trendAllows(int d, int emaD, int internalD, int streak) =>
    switch trendModeInput
        "EMA only"      => emaD == d
        "Internal only" => internalD == d
        "Either"        => internalD == d or emaD == d
        => internalD == d and streak >= (emaD == d ? 1 : 2)

// Cancels a setup's resting order and ends its level line at endBar.
retireSetup(NoSetup s, int endBar) =>
    strategy.cancel(s.orderId)
    if not na(s.levelLine)
        line.set_x2(s.levelLine, endBar)

// Draws the position-tool zones: TP box and SL box meeting at a grey entry line.
drawZones(ActiveTrade t, int leftBar, int rightBar, float entryPx) =>
    t.tpBox := box.new(leftBar, math.max(entryPx, t.tpPrice), rightBar, math.min(entryPx, t.tpPrice),
         border_color = color.new(TP_COLOR, 100), bgcolor = color.new(TP_COLOR, ZONE_OPEN_TRANSP))
    t.slBox := box.new(leftBar, math.max(entryPx, t.slPrice), rightBar, math.min(entryPx, t.slPrice),
         border_color = color.new(SL_COLOR, 100), bgcolor = color.new(SL_COLOR, ZONE_OPEN_TRANSP))
    t.entryLine := line.new(leftBar, entryPx, rightBar, entryPx, color = ENTRY_LINE_COLOR, width = 1)

// Processes a fill: freezes SL/TP from the ACTUAL fill price, cancels every other pending
// setup (first touch wins) and records the entry circle. Returns the entry alert text,
// or "" if no stored setup matches the fill.
processFill(ActiveTrade t, EntryMark m, array<NoSetup> pending, string fillId, float fillPrice, int fillBar, int dir, bool isOpen) =>
    int idx = -1
    for [i, s] in pending
        if s.orderId == fillId
            idx := i
            break
    float risk  = na
    float level = na
    if idx >= 0
        NoSetup filled = pending.get(idx)
        risk  := na(filled.stopPrice) ? filled.noRange * riskMultiplierInput : (fillPrice - filled.stopPrice) * dir
        level := filled.level
    // A gap can fill the limit at or beyond the swing stop: the stop is already breached.
    bool gappedPastStop = not na(risk) and risk <= 0
    if gappedPastStop
        risk := na
    t.entryId := fillId
    t.level   := level
    t.slPrice := fillPrice - dir * risk
    t.tpPrice := fillPrice + dir * risk * rrRatioInput
    for [i, s] in pending
        if i == idx
            if not na(s.levelLine)
                line.set_x2(s.levelLine, fillBar)
        else
            retireSetup(s, bar_index)
    pending.clear()
    m.barIndex  := fillBar
    m.price     := fillPrice
    m.direction := dir
    if isOpen and showActiveSlTpInput and not na(risk)
        drawZones(t, fillBar, bar_index, fillPrice)
    if gappedPastStop
        strategy.close(fillId, comment = "Gap past SL")
    else if na(risk)
        // Unreachable by design (every entry id belongs to a stored setup), but never hold a position without a stop.
        log.error("NO Candle: no stored setup for fill {0}; closing the position.", fillId)
        strategy.close(fillId, comment = "No setup data")
    string msg = na(risk) ? "" : "NO Candle " + directionText(dir) + " entry | " + symbolText() +
         " | level " + str.tostring(t.level, format.mintick) +
         " | fill " + str.tostring(fillPrice, format.mintick) +
         " | SL " + str.tostring(t.slPrice, format.mintick) +
         " | TP " + str.tostring(t.tpPrice, format.mintick)
    msg

// ─── State ───────────────────────────────────────────────────────────────────
var array<NoSetup> setups          = array.new<NoSetup>()
var int            setupSeq        = 0
var ActiveTrade    trade           = ActiveTrade.new()
var EntryMark      entryMark       = EntryMark.new()
var int            lastClosedCount = 0
// varip: each alert must fire once even though `var` state rolls back on every realtime tick.
varip string lastEntryAlertId = ""
varip string lastExitAlertId  = ""

// ─── Trend and NO candle detection ───────────────────────────────────────────
bool  isFifteenMinute = timeframe.period == "15"
float emaValue        = ta.ema(close, emaLengthInput)
int   emaDir          = close > emaValue ? 1 : close < emaValue ? -1 : 0
bool  historyReady    = bar_index > emaLengthInput and not na(emaValue)

// ─── Internal structure: body swings and breaks of structure ─────────────────
float bodyHigh = math.max(open, close)
float bodyLow  = math.min(open, close)
float pivotHi  = ta.pivothigh(bodyHigh, pivotLengthInput, pivotLengthInput)
float pivotLo  = ta.pivotlow(bodyLow, pivotLengthInput, pivotLengthInput)

float pivotHiWick = high[pivotLengthInput]   // wick extreme of the candle a new swing forms on
float pivotLoWick = low[pivotLengthInput]

var float swingHigh       = na
var float swingLow        = na
var float swingHighWick   = na
var float swingLowWick    = na
var bool  swingHighBroken = true
var bool  swingLowBroken  = true
var int   internalDir     = 0   // direction of the most recent BOS
var int   bosStreak       = 0   // consecutive BOS in internalDir

bool markHH = false
bool markLH = false
bool markHL = false
bool markLL = false
if barstate.isconfirmed
    // New swings first (a swing confirmed on this bar can't be broken by this bar's close).
    if not na(pivotHi)
        markHH          := na(swingHigh) or pivotHi > swingHigh
        markLH          := not markHH
        swingHigh       := pivotHi
        swingHighWick   := pivotHiWick
        swingHighBroken := false
    if not na(pivotLo)
        markLL         := na(swingLow) or pivotLo < swingLow
        markHL         := not markLL
        swingLow       := pivotLo
        swingLowWick   := pivotLoWick
        swingLowBroken := false
    // Break of structure: a close beyond the last unbroken swing. Each swing breaks once.
    if not swingHighBroken and close > swingHigh
        bosStreak       := internalDir == 1 ? bosStreak + 1 : 1
        internalDir     := 1
        swingHighBroken := true
    if not swingLowBroken and close < swingLow
        bosStreak      := internalDir == -1 ? bosStreak + 1 : 1
        internalDir    := -1
        swingLowBroken := true

bool longAllowed  = trendAllows(1, emaDir, internalDir, bosStreak)
bool shortAllowed = trendAllows(-1, emaDir, internalDir, bosStreak)

// Tolerance 0 = exact equality. Otherwise a tiny epsilon absorbs float noise in the tick distance.
float wickTolerance = wickToleranceTicksInput * syminfo.mintick + syminfo.mintick * 1e-6
bool  openIsLow     = wickToleranceTicksInput == 0 ? open == low  : open - low  <= wickTolerance
bool  openIsHigh    = wickToleranceTicksInput == 0 ? open == high : high - open <= wickTolerance
bool  isBullNo      = close > open and openIsLow
bool  isBearNo      = close < open and openIsHigh

// ─── 1. Closed trade: finalize TP/SL zones, then reset (not gated by isconfirmed)
if strategy.closedtrades > lastClosedCount
    int    ci        = strategy.closedtrades - 1
    string closedId  = strategy.closedtrades.entry_id(ci)
    int    closedDir = strategy.closedtrades.size(ci) > 0 ? 1 : -1
    int    entryBi   = strategy.closedtrades.entry_bar_index(ci)
    int    exitBi    = strategy.closedtrades.exit_bar_index(ci)
    float  entryPx   = strategy.closedtrades.entry_price(ci)
    float  exitPx    = strategy.closedtrades.exit_price(ci)
    // The trade opened and closed before this bar's committed state saw it open: process its fill first.
    if closedId != trade.entryId
        string closedEntryMsg = processFill(trade, entryMark, setups, closedId, entryPx, entryBi, closedDir, false)
        if closedEntryMsg != "" and lastEntryAlertId != closedId
            lastEntryAlertId := closedId
            alert(closedEntryMsg, alert.freq_all)
    bool hitTp   = (exitPx - entryPx) * closedDir > 0
    int  rightBi = math.max(exitBi, entryBi + 1)   // same-candle trades still get a visible, one-bar box
    if not na(trade.slPrice) and showTradeLinesInput
        if na(trade.tpBox)
            drawZones(trade, entryBi, rightBi, entryPx)
        else
            box.set_right(trade.tpBox, rightBi)
            box.set_right(trade.slBox, rightBi)
            line.set_x2(trade.entryLine, rightBi)
        // Highlight the side that was hit; fade the other.
        box.set_bgcolor(trade.tpBox, color.new(TP_COLOR, hitTp ? ZONE_HIT_TRANSP : ZONE_MISS_TRANSP))
        box.set_bgcolor(trade.slBox, color.new(SL_COLOR, hitTp ? ZONE_MISS_TRANSP : ZONE_HIT_TRANSP))
    else
        box.delete(trade.tpBox)
        box.delete(trade.slBox)
        line.delete(trade.entryLine)
    if not na(trade.slPrice) and showTradeLabelsInput
        label.new(rightBi, trade.tpPrice, "TP", style = label.style_label_left, color = color.new(TP_COLOR, 100), textcolor = TP_COLOR, size = size.tiny)
        label.new(rightBi, trade.slPrice, "SL", style = label.style_label_left, color = color.new(SL_COLOR, 100), textcolor = SL_COLOR, size = size.tiny)
    if lastExitAlertId != closedId
        lastExitAlertId := closedId
        alert("NO Candle " + directionText(closedDir) + " exit (" + (hitTp ? "TP" : "SL") + ") | " + symbolText() +
             " | exit " + str.tostring(exitPx, format.mintick), alert.freq_all)
    // Flat-state reset, only after the zones above have used the stored SL/TP.
    trade           := ActiveTrade.new()
    lastClosedCount := strategy.closedtrades

// ─── 2. Open trade: process a new fill once, keep the bracket in place ───────
if strategy.opentrades > 0
    string openId = strategy.opentrades.entry_id(0)
    if openId != trade.entryId
        int    openDir      = strategy.opentrades.size(0) > 0 ? 1 : -1
        string openEntryMsg = processFill(trade, entryMark, setups, openId, strategy.opentrades.entry_price(0),
             strategy.opentrades.entry_bar_index(0), openDir, true)
        if openEntryMsg != "" and lastEntryAlertId != openId
            lastEntryAlertId := openId
            alert(openEntryMsg, alert.freq_all)
    if not na(trade.slPrice)
        strategy.exit("Exit " + trade.entryId, from_entry = trade.entryId, stop = trade.slPrice, limit = trade.tpPrice,
             comment_loss = "SL", comment_profit = "TP")
        // Open-trade zones grow with each candle until the exit.
        if not na(trade.tpBox)
            box.set_right(trade.tpBox, bar_index)
            box.set_right(trade.slBox, bar_index)
            line.set_x2(trade.entryLine, bar_index)

// ─── 3. Setup management: confirmed candles only ─────────────────────────────
bool newLongSetup  = false
bool newShortSetup = false
if barstate.isconfirmed
    // Expire once the last valid candle has closed; cancel if the trend mode no longer allows the direction.
    if setups.size() > 0
        for i = setups.size() - 1 to 0
            NoSetup s = setups.get(i)
            bool stillAllowed = s.direction == 1 ? longAllowed : shortAllowed
            if bar_index >= s.expiryBar or not stillAllowed
                retireSetup(s, bar_index)
                setups.remove(i)
    int newDir = isBullNo and longAllowed and enableLongsInput ? 1 : isBearNo and shortAllowed and enableShortsInput ? -1 : 0
    // Swing SL: the most recent confirmed swing as of this close (swings confirm pivot-length bars late).
    bool  swingSl   = slModeInput == "Last swing"
    float swingRef  = newDir == 1 ? (slUseWickInput ? swingLowWick : swingLow) : (slUseWickInput ? swingHighWick : swingHigh)
    float swingStop = swingSl ? swingRef - newDir * slBufferTicksInput * syminfo.mintick : na
    bool  stopValid = not swingSl or (not na(swingStop) and (newDir == 1 ? swingStop < open : swingStop > open))
    if newDir != 0 and stopValid and isFifteenMinute and historyReady and strategy.opentrades == 0
        while setups.size() >= maxActiveSetupsInput
            retireSetup(setups.get(0), bar_index)   // oldest first
            setups.remove(0)
        setupSeq += 1
        string newOrderId = (newDir == 1 ? "NO L" : "NO S") + str.tostring(setupSeq)
        int    expiry     = bar_index + setupValidityBarsInput
        line   lvlLine    = showPendingLevelsInput ? line.new(bar_index, open, expiry, open, color = color.new(newDir == 1 ? TP_COLOR : SL_COLOR, 50), style = line.style_dotted, width = 1) : na
        setups.push(NoSetup.new(direction = newDir, level = open, noHigh = high, noLow = low, noRange = high - low,
             creationBar = bar_index, expiryBar = expiry, stopPrice = swingStop, orderId = newOrderId, seq = setupSeq, levelLine = lvlLine))
        // Resting limit at the level. process_orders_on_close = false, so the earliest possible fill is candle #1.
        // All pending setups were created since the last trade, so they share this OCA group: the first fill cancels
        // the rest at broker level, even when a trade opens and closes inside one candle.
        strategy.entry(newOrderId, newDir == 1 ? strategy.long : strategy.short, limit = open, comment = newOrderId,
             oca_name = "NO-OCA-" + str.tostring(strategy.closedtrades), oca_type = strategy.oca.cancel)
        newLongSetup  := newDir == 1
        newShortSetup := newDir == -1

// ─── Visuals ─────────────────────────────────────────────────────────────────
plot(showEmaInput ? emaValue : na, "EMA", color = color.new(EMA_COLOR, 30), linewidth = 1)

// Swings are drawn back on the pivot candle itself; they appear once confirmed (pivot length bars later).
plotshape(showStructureInput and markHH ? pivotHi : na, "Swing HH", shape.diamond, location.absolute, STRUCT_COLOR, offset = -pivotLengthInput, text = "HH", textcolor = STRUCT_COLOR, size = size.tiny, display = display.pane)
plotshape(showStructureInput and markLH ? pivotHi : na, "Swing LH", shape.diamond, location.absolute, STRUCT_COLOR, offset = -pivotLengthInput, text = "LH", textcolor = STRUCT_COLOR, size = size.tiny, display = display.pane)
plotshape(showStructureInput and markHL ? pivotLo : na, "Swing HL", shape.diamond, location.absolute, STRUCT_COLOR, offset = -pivotLengthInput, text = "HL", textcolor = STRUCT_COLOR, size = size.tiny, display = display.pane)
plotshape(showStructureInput and markLL ? pivotLo : na, "Swing LL", shape.diamond, location.absolute, STRUCT_COLOR, offset = -pivotLengthInput, text = "LL", textcolor = STRUCT_COLOR, size = size.tiny, display = display.pane)
// Active (unbroken) swing levels: the line ends on the candle that closes through it (the BOS).
plot(showStructureInput and not swingHighBroken ? swingHigh : na, "Swing high level", color = color.new(STRUCT_COLOR, 40), style = plot.style_steplinebr, display = display.pane)
plot(showStructureInput and not swingLowBroken ? swingLow : na, "Swing low level", color = color.new(STRUCT_COLOR, 40), style = plot.style_steplinebr, display = display.pane)
plotshape(showNoCandlesInput and newLongSetup,  "Bullish NO candle", shape.triangleup,   location.belowbar, TP_COLOR, size = size.tiny, display = display.pane)
plotshape(showNoCandlesInput and newShortSetup, "Bearish NO candle", shape.triangledown, location.abovebar, SL_COLOR, size = size.tiny, display = display.pane)
plotshape(showTradeCirclesInput and entryMark.barIndex == bar_index ? entryMark.price : na, "Entry", shape.circle, location.absolute,
     entryMark.direction == 1 ? TP_COLOR : SL_COLOR, size = size.tiny, display = display.pane)

if barstate.islast and not isFifteenMinute
    var table tfWarning = table.new(position.top_right, 1, 1)
    table.cell(tfWarning, 0, 0, "NO Candle runs on the 15m chart only. No setups on this timeframe.",
         text_color = color.white, bgcolor = color.new(color.orange, 15), text_size = size.small)
